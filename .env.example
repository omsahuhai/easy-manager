# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Find these values in your Supabase project dashboard:
# Go to: https://supabase.com/dashboard/project/_/settings/api
#
# 1. Project URL:
#    Example: https://your-project-id.supabase.co
#    For local development with Supabase CLI: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Project API Key (Publishable / Anon Key):
#    You can use either NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY or NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
